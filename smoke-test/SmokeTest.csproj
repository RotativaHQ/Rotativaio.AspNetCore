<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>netcoreapp3.1;net5;net6;net7;net8;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>10.0</LangVersion>
		<RotativaioPackageVersion Condition="'$(RotativaioPackageVersion)' == ''">1.6.3-beta</RotativaioPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Rotativaio.AspNetCore" Version="$(RotativaioPackageVersion)" />
	</ItemGroup>

</Project>
